[Desktop Entry]
Encoding=UTF-8
Name=WEPLUSforKDE (Wallpaper Engine)
Type=Service
Icon=preferences-desktop-wallpaper
Comment=WEPLUSforKDE — Enhanced Wallpaper Engine for KDE Plasma 6 by @vixtrs

X-Plasma-MainScript=ui/main.qml
X-KDE-ServiceTypes=Plasma/Wallpaper
X-KDE-ParentApp=org.kde.plasmashell
X-KDE-PluginInfo-Name=com.github.catsout.wallpaperEngineKde
X-KDE-PluginInfo-Author=@vixtrs, catsout
X-KDE-PluginInfo-Category=
X-KDE-PluginInfo-License=GPLv2+
X-KDE-PluginInfo-Version=@PROJECT_VERSION@
X-KDE-PluginInfo-Website=https://github.com/vixtrs/WEPLUSforKDE
